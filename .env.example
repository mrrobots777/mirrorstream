NODE_ENV=production
PORT=7000
# vazio = auto-detecta o domínio no primeiro request (BeamUp: defina a URL do app)
PUBLIC_BASE_URL=
DATA_DIR=/tmp
NODE_OPTIONS=--max-old-space-size=224

# TMDB — VALOR DE EXEMPLO, NAO UMA CHAVE. A chave real vive no ambiente
# (`config/tmdb.js` para o build, `beamup secrets TMDB_API_KEY` no gateway).
# MEDIDO 10/10/2026: a chave real ficou publica neste arquivo de 02/10 a
# 10/10 — o repositorio e' PUBLICO. Um `.env.example` com segredo real e' o
# vazamento mais comum que existe: parece inofensivo e nao e'.
TMDB_API_KEY=

# Kakito / Blaze (Xtream Codes principal)
IPTV_SERVER=kakito.xyz
IPTV_USERNAME=
IPTV_PASSWORD=
IPTV_PORT=443

# Space (Xtream Codes)
XTREAM_SPACE_SERVER=telaplay93.top
XTREAM_SPACE_USER=
XTREAM_SPACE_PASS=
XTREAM_SPACE_PORT=80

# CDN Proxy (Cloudflare Worker)
CDN_PROXY=https://mirror-cdn.dev-avmirror.workers.dev

# Relay VPS (proxy de streams — opcional, se não definido usa PUBLIC_BASE_URL)
# RELAY_BASE_URL=http://IP_DA_VPS_RELAY:7100

# Extras (opcionais)
# CUSTOM_DNS=1.1.1.1,1.0.0.1
# IPTV_SOURCES=
# IPTV_PROXY=
# REDIS_URL=
# BLAZE_PROXY=
# SPACE_PROXY=
# XTREAM_EXTRA1_USER=
# XTREAM_EXTRA1_PASS=
# XTREAM_EXTRA1_SERVER=
# XTREAM_EXTRA1_PORT=
# XTREAM_EXTRA1_NAME=
# XTREAM_EXTRA1_EPISODES=false
# XTREAM_EXTRA2_USER=
# XTREAM_EXTRA2_PASS=
# XTREAM_EXTRA2_SERVER=
# XTREAM_EXTRA2_PORT=
# XTREAM_EXTRA2_NAME=
# XTREAM_EXTRA2_EPISODES=false
